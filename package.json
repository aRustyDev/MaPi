    "build:login-assets": "node scripts/build-login-assets.mjs",
    "baseline": "node scripts/baseline.mjs",
    "dev:app": "wrangler dev --config wrangler.app.jsonc --env-file .dev.vars.app",
    "prepare:app-local": "node scripts/app-secrets.mjs --local",
    "prepare:app-staging": "node scripts/app-secrets.mjs",
