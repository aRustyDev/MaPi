    "fixture": "node scripts/fixture.mjs",
    "test:baseline": "node scripts/fixture.mjs --test",
    "test:worker": "node scripts/test-worker.mjs",
    "test:app": "node scripts/test-app.mjs",
    "test:projects": "node scripts/test-project-routing.mjs",
