    "test:management-parity": "node scripts/test-management-parity.mjs",
    "test:shared-management": "node scripts/test-shared-management.mjs",
    "test:oauth-composition": "node scripts/test-oauth-composition.mjs",
    "test:oauth-browser": "node scripts/test-oauth-browser.mjs",
    "test:hosted-oidc": "node scripts/test-hosted-oidc.mjs",
    "test:deploy-preservation": "node scripts/test-deploy-preservation.mjs",
    "test:oidc-admin-cli": "node scripts/test-oidc-admin-cli.mjs",
    "test:oidc-project-isolation": "node scripts/test-oidc-project-isolation.mjs",
    "test:native-oidc": "node scripts/test-native-oidc.mjs",
    "test:native-flow-release": "node scripts/test-native-flow-release.mjs",
    "test:flow-release": "node scripts/test-flow-release.mjs",
    "test:flow-release-app": "node scripts/test-flow-release-app.mjs",
    "test:client-assertions": "node scripts/test-client-assertions.mjs",
    "test:official-login": "node scripts/test-official-login.mjs",
    "test:official-projects": "node scripts/test-official-projects.mjs",
    "test:relocation": "node scripts/test-relocation.mjs",
    "test:relocation-chunks": "node scripts/test-relocation-chunks.mjs",
    "build:egress-spike": "node scripts/build-egress-spike.mjs",
    "test:egress-spike": "node scripts/test-egress-spike.mjs",
    "test:sql-bind": "node scripts/test-sql-bind.mjs",
    "test:sqlite-bridge": "node scripts/test-sqlite-bridge.mjs",
    "test:system-parity": "node scripts/test-system-parity.mjs",
    "inventory": "node scripts/parity-inventory.mjs",
    "inventory:check": "node scripts/parity-inventory.mjs --check",
    "test:browser": "node scripts/test-browser.mjs",
    "benchmark:app": "node scripts/benchmark-app.mjs",
    "benchmark:flow": "node scripts/benchmark-flow.mjs",
    "benchmark:cold": "node scripts/cold-app.mjs",
    "dev": "wrangler dev --env-file .dev.vars.poc",
