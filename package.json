{
  "name": "mapi-nextgen-workers-poc",
  "private": true,
  "type": "module",
  "bin": {
    "mapi": "./scripts/mapi.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:flow": "bash scripts/build-flow.sh",
