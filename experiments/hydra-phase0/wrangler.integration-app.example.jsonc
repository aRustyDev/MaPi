{
  // Replace placeholders. Bootstrap the isolated project before enabling Hydra.
  "name": "<nextgen-staging-worker-name>",
  "main": "../../worker/app.js",
  "alias": { "./wasm-module.js": "../../worker/oidc-wasm-module.js" },
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../../worker/assets", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [
    { "name": "NEXTGEN_APPLICATION", "class_name": "NextgenApplication" },
    { "name": "PROJECT_REGISTRY", "class_name": "ProjectRegistry" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NextgenApplication", "ProjectRegistry"] }],
  "services": [{
    "binding": "HYDRA_ISSUER_WORKER",
    "service": "<private-hydra-worker-name>",
    "entrypoint": "HydraIssuer"
  }],
  "vars": {
    "MAPI_OFFICIAL_LOGIN": "1",
    "MAPI_HYDRA_ENABLED": "1",
    "MAPI_APP_ORIGIN": "https://<staging-host>",
    "HYDRA_ISSUER": "https://<staging-host>/oauth/<project-id>"
  }
  // Provide MAPI_MASTER_KEY and MAPI_OPERATOR_TOKEN as Worker secrets.
}
