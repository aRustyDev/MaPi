{
  "name": "mapi-sql-result-spill-local-only",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "durable_objects": { "bindings": [
    { "name": "OWNER", "class_name": "Owner" },
    { "name": "SPILL", "class_name": "Spill" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Owner", "Spill"] }]
}
