{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapi-phase1-control-local",
  "main": "worker/phase1-control.js",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "NEXTGEN_APPLICATION", "class_name": "NextgenApplication", "script_name": "mapi-phase1-owner-local" },
      { "name": "PROJECT_REGISTRY", "class_name": "ProjectRegistry", "script_name": "mapi-phase1-owner-local" }
    ]
  }
}
