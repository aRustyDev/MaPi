{
  "name": "mapi-relocation-control-local",
  "main": "relocation-control-bench-worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "vars": { "MAPI_LOCAL_TEST": "1" },
  "durable_objects": { "bindings": [{ "name": "PROBE", "class_name": "ControlProbe" }] },
