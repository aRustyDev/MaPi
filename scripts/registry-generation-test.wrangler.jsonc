{
  "name": "mapi-registry-generation-test",
  "main": "registry-generation-test-worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY_TEST", "class_name": "RegistryGenerationTest" },
      { "name": "NEXTGEN_APPLICATION", "class_name": "RegistryGenerationOwner" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistryGenerationTest", "RegistryGenerationOwner"] }]
}
