{
  "name": "mapi-real-relocation-test",
  "main": "real-relocation-test-worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "vars": { "MAPI_LOCAL_TEST": "1", "COORDINATOR_SECRET": "secret", "MAPI_RELOCATION_ENABLED": "1", "MAPI_RELOCATION_CONTROL_TOKEN": "move-secret", "MAPI_FENCE_WRITERS_DRAINED": "1" },
  "durable_objects": { "bindings": [
    { "name": "REGISTRY", "class_name": "RealRegistry" },
    { "name": "PROJECT_REGISTRY", "class_name": "RealRegistry" },
    { "name": "OWNER", "class_name": "RealOwner" },
    { "name": "NEXTGEN_APPLICATION", "class_name": "RealOwner" },
    { "name": "COORDINATOR", "class_name": "RealCoordinator" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealRegistry", "RealOwner", "RealCoordinator"] }]
}
