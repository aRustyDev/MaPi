{
  "name": "mapi-large-real-relocation-test",
  "main": "large-real-relocation-test-worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "vars": { "MAPI_LOCAL_TEST": "1", "MAPI_OIDC_EXPERIMENTAL": "1", "MAPI_RELOCATION_ENABLED": "1", "MAPI_RELOCATION_CONTROL_TOKEN": "large-move-secret", "MAPI_FENCE_WRITERS_DRAINED": "1" },
  "durable_objects": { "bindings": [
    { "name": "PROJECT_REGISTRY", "class_name": "TestProjectRegistry" },
    { "name": "NEXTGEN_APPLICATION", "class_name": "LargeOwner" },
    { "name": "COORDINATOR", "class_name": "RelocationCoordinator" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestProjectRegistry", "LargeOwner", "RelocationCoordinator"] }]
}
